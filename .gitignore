# Node/Monorepo standard ignores
node_modules/
.pnpm-store/
.pnp.cjs
.pnp.data.json

# Build outputs
packages/**/dist/
dist/
.next/
.out/
.vercel/

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Environment variables
.env
.env.*
packages/**/.env
packages/**/.env.*
# But keep .env.example files
!.env.example
!packages/**/.env.example

# Prisma / SQLite
packages/server/prisma/dev.db
packages/server/prisma/dev.db-journal
packages/**/prisma/*.db
packages/**/prisma/*.db-journal
# Test databases
test.db
test.db-journal
packages/**/test.db
packages/**/test.db-journal

# OS files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.swp

# Turborepo cache
.turbo/

# Next.js
packages/client/.next/
packages/client/out/

# Testing and Coverage
coverage/
.vitest/
test-results/
*.test.db
*.test.db-journal

# Code quality reports and caches
.jscpd/
.eslintcache
**/node_modules/.cache/
*.report.json
*.report.txt
*-report.*

# Lockfiles (keep only one for chosen PM)
package-lock.json
yarn.lock

# Documentation files to keep (explicitly not ignored)
README.md
docs/**/*.md
*.md
