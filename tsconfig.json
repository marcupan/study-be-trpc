{
  "compilerOptions": {
    // Language and Environment
    "target": "ES2022",
    "lib": ["ES2022", "dom", "esnext.asynciterable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "preserve",
    // Type Checking - Strict Mode (all flags explicitly declared)
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    // Additional Type Checking
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    // Note: exactOptionalPropertyTypes disabled for better library compatibility
    "exactOptionalPropertyTypes": false,
    // Module Resolution
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    // Emit
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": true,
    "declaration": true,
    "declarationMap": true,
    // Interop Constraints
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // Completeness
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    // Path Mapping
    "baseUrl": "."
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo", "coverage"],
  "include": ["./packages/**/*.ts", "./packages/**/*.tsx", "./vitest.config.ts"]
}
