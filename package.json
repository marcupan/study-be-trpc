{
  "name": "tasksync",
  "version": "1.0.0",
  "description": "A tRPC-Powered Collaborative Task Board",
  "main": "index.js",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:client & npm run dev:server & npm run dev:shared",
    "dev:client": "cd packages/client && npm run dev",
    "dev:server": "cd packages/server && npm run dev",
    "dev:shared": "cd packages/shared && npm run dev",
    "build": "turbo run build",
    "start": "node packages/server/dist/index.js",
    "typecheck": "tsc --project packages/shared/tsconfig.json --noEmit && tsc --project packages/server/tsconfig.json --noEmit && tsc --project packages/client/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "trpc",
    "typescript",
    "react",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.0.16"
  }
}
