{
  "name": "tasksync",
  "version": "1.0.0",
  "description": "A tRPC-Powered Collaborative Task Board",
  "main": "index.js",
  "private": true,
  "packageManager": "pnpm@8.6.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:client & npm run dev:server & npm run dev:shared",
    "dev:client": "cd packages/client && npm run dev",
    "dev:server": "cd packages/server && npm run dev",
    "dev:shared": "cd packages/shared && npm run dev",
    "build": "turbo run build",
    "start": "node packages/server/dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "trpc",
    "typescript",
    "react",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "turbo": "^1.10.16",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "inflight": "^2.0.0",
    "rimraf": "^5.0.0",
    "glob": "^10.0.0",
    "@humanwhocodes/config-array": "@eslint/config-array",
    "@humanwhocodes/object-schema": "@eslint/object-schema",
    "npmlog": "^7.0.0",
    "gauge": "^5.0.0"
  }
}
