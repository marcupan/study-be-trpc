# Database connection URL (SQLite for development, PostgreSQL recommended for production)
DATABASE_URL="file:./prisma/dev.db"

# JWT secret key (MUST be at least 32 characters - generate a secure one for production)
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long-change-in-production"

# Server port
PORT="4000"

# Environment (development, production, test)
NODE_ENV="development"

# Optional: Frontend URL for CORS (production only)
# FRONTEND_URL="https://your-domain.com"

# Optional: Log level (debug, info, warn, error)
# LOG_LEVEL="info"
