{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Output
    "outDir": "./dist",
    "rootDir": "./src",
    // Project References (shared package used by a client & server)
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    // Shared package settings
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    // Ensure a strict mode is inherited and enforced
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Note: exactOptionalPropertyTypes can be too strict for some use cases
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
